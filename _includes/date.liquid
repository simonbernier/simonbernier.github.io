{% comment %}
  Formats include.date in the page's language. Needs the variables set by i18n.liquid.
  include.short: abbreviated month. English: "November 01, 2026" / "Nov 01, 2026"; French: "1er novembre 2026" / "1er nov. 2026".
{% endcomment %}
{%- assign month_index = include.date | date: '%-m' | minus: 1 -%}
{%- if include.short -%}
  {%- assign month = t.months_short[month_index] -%}
{%- else -%}
  {%- assign month = t.months[month_index] -%}
{%- endif -%}
{%- if page_lang == 'fr' -%}
  {%- assign day = include.date | date: '%-d' -%}
  {%- if day == '1' -%}
    {%- assign day = '1er' -%}
  {%- endif -%}
  {{- day }} {{ month }} {{ include.date | date: '%Y' -}}
{%- else -%}
  {{- month }} {{ include.date | date: '%d' }}, {{ include.date | date: '%Y' -}}
{%- endif -%}
